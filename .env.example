# Geena environment (test). The backend base URL and the dashboard (for deep links to the
# grant screen). Tokens are NEVER configuration — the ceremony mints them per session.
GEENA_API_URL=https://api.test.geena.eu
GEENA_DASHBOARD_URL=https://app.test.geena.eu

# One OAuth app per demo brand (Organization -> Apps -> New app; the client id is the slug you
# choose, the secret is shown exactly once — store it here in the same breath).
# Each app's allowedOrigins must contain the origin the demo runs on
# (https://yield.demo.test.geena.eu, or http://yield.localhost:3005 for local dev).
YIELD_CLIENT_ID=yield-demo
YIELD_CLIENT_SECRET=
# The published manifest this demo opens (initiation: BOTH). Ids are minted at publish —
# copy them from the studio.
YIELD_MANIFEST_ID=

SIGNALIO_CLIENT_ID=signalio-demo
SIGNALIO_CLIENT_SECRET=
SIGNALIO_MANIFEST_ID=

COVER_CLIENT_ID=cover-demo
COVER_CLIENT_SECRET=
COVER_MANIFEST_ID=
